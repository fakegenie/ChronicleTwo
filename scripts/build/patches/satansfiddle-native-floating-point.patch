+
+#[test]
+fn native_floating_point_is_opt_in_and_preserves_helper_masks() {
+    let old = Config::parse(include_str!("../compile_sample/config.toml")).unwrap();
+    assert!(!old.translation_units[0].native_floating_point);
+    let config = parse("[[translation_units]]\nname='src/test.cpp'\ngpr_helper_mask=16\nfpr_helper_mask=0\nnative_floating_point=true").unwrap();
+    let row = &config.translation_units[0];
+    assert_eq!(row.name, "test.cpp");
+    assert_eq!(row.gpr_helper_mask, 16);
+    assert!(row.native_floating_point);
+    let encoded = serde_json::to_string(&config).unwrap();
+    assert!(Config::parse(&encoded).unwrap().translation_units[0].native_floating_point);
+}
+
+#[test]
+fn native_floating_point_rejects_conflicting_overrides() {
+    let unit = "[[translation_units]]\nname='test.cpp'\ngpr_helper_mask=16\nfpr_helper_mask=0\nnative_floating_point=true\n";
+    let literal = "[[floating_point.literal_overrides]]\ntranslation_unit='test.cpp'\nvalue_type='binary32'\nvalue_bits='0x3f800000'\nreload=false\n";
+    for policy in [EXPRESSION, literal] {
+        let error = parse(&format!("{unit}{policy}")).unwrap_err();
+        assert!(error.to_string().contains("conflicts with native_floating_point"));
+        assert!(parse(&format!("{unit}{}", policy.replace("test.cpp", "other.cpp"))).is_ok());
+    }
+    assert!(parse(&unit.replace("native_floating_point=true", "native_floating_point=1")).is_err());
+}
